{% extends 'base.html.twig' %}

{% block title %}
    Ajouter une destination – MonSite
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/styles.css') }}">
    <meta name="turbo-visit-control" content="reload">
    <style>
        .section__container {
            max-width: 800px;
            margin: 40px auto;
            padding: 20px;
            background: white;
            border-radius: 10px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        }
        .section__header {
            text-align: center;
            margin-bottom: 30px;
            color: #2c3e50;
        }
        .input__group {
            margin-bottom: 20px;
        }
        .input__group label {
            display: block;
            margin-bottom: 8px;
            font-weight: bold;
            color: #555;
        }
        .input__group input, .input__group textarea {
            width: 100%;
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 5px;
            font-size: 1rem;
        }
        .btn {
            padding: 12px 30px;
            border: none;
            border-radius: 5px;
            font-size: 1rem;
            cursor: pointer;
            transition: 0.3s;
            background-color: #3498db;
            color: white;
        }
        .btn:hover {
            background-color: #2980b9;
        }
    </style>
{% endblock %}

{% block body %}
<section class="section__container">
    <h2 class="section__header">Ajouter une destination</h2>

    {% for flash in app.flashes('success') %}
        <div class="alert alert-success">
            {{ flash }}
        </div>
    {% endfor %}

    {{ form_start(form, {'attr': {'data-turbo': 'false'}}) }}
        <div class="input__group">
            {{ form_label(form.name) }}
            {{ form_widget(form.name, {'attr': {'placeholder': 'Nom de la destination'}}) }}
            {{ form_errors(form.name) }}
        </div>

        <div class="input__group">
            {{ form_label(form.country) }}
            {{ form_widget(form.country, {'attr': {'placeholder': 'Pays'}}) }}
            {{ form_errors(form.country) }}
        </div>

        <div class="input__group">
            {{ form_label(form.description) }}
            {{ form_widget(form.description, {'attr': {'placeholder': 'Description', 'rows': 4}}) }}
            {{ form_errors(form.description) }}
        </div>

        <div class="input__group">
            {{ form_label(form.climate) }}
            {{ form_widget(form.climate, {'attr': {'placeholder': 'Climat'}}) }}
            {{ form_errors(form.climate) }}
        </div>

        <button type="submit" class="btn">Enregistrer</button>
    {{ form_end(form) }}
</section>
{% endblock %}
