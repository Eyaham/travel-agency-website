{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
<link rel="stylesheet" href="{{ asset('css/styles.css') }}">

<section class="auth__container">
    <div class="auth__box">
        <h2>Connexion</h2>

        {# Affichage des messages flash #}
        {% for message in app.flashes('success') %}
            <div class="alert alert-success">
                {{ message }}
            </div>
        {% endfor %}

        {# Affichage des erreurs de connexion #}
        {% if error %}
            <div class="alert alert-danger">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <form action="{{ path('app_login') }}" method="post" class="auth-form">
            {# CSRF token #}
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div class="form-group">
                <label for="username">Email :</label>
                <input
                    type="email"
                    id="username"
                    name="_username"
                    value="{{ last_username }}"
                    class="form-control"
                    required
                    autofocus
                    autocomplete="email"
                >
            </div>

            <div class="form-group">
                <label for="password">Mot de passe :</label>
                <input
                    type="password"
                    id="password"
                    name="_password"
                    class="form-control"
                    required
                    autocomplete="current-password"
                >
            </div>

            <div class="form-group form-check">
                <input type="checkbox" id="remember_me" name="_remember_me" class="form-check-input">
                <label for="remember_me" class="form-check-label">Se souvenir de moi</label>
            </div>

            <button type="submit" class="btn btn-primary btn-block">Se connecter</button>
        </form>

        <p class="auth__footer">
            Pas encore de compte ? <a href="{{ path('app_register') }}">S'inscrire</a>
        </p>
    </div>
</section>
{% endblock %}
