{% extends 'base.html.twig' %}

{% block title %}
    Ajouter une activité – MonSite
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/styles.css') }}">
    <meta name="turbo-visit-control" content="reload">
    <style>
        .section__container {
            max-width: 800px;
            margin: 40px auto;
            padding: 20px;
            background: white;
            border-radius: 10px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        }
        .section__header {
            text-align: center;
            margin-bottom: 30px;
            color: #2c3e50;
        }
        .input__group {
            margin-bottom: 20px;
        }
        .input__group label {
            display: block;
            margin-bottom: 8px;
            font-weight: bold;
            color: #555;
        }
        .input__group input,
        .input__group textarea {
            width: 100%;
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 5px;
            font-size: 1rem;
        }
        .input__group textarea {
            resize: vertical;
            min-height: 100px;
        }
        .btn {
            padding: 12px 30px;
            border: none;
            border-radius: 5px;
            font-size: 1rem;
            cursor: pointer;
            margin-right: 10px;
            transition: 0.3s;
        }
        .btn[type="submit"] {
            background-color: #3498db;
            color: white;
        }
        .btn[type="submit"]:hover {
            background-color: #2980b9;
        }
        .btn[type="reset"] {
            background-color: #95a5a6;
            color: white;
        }
        .btn[type="reset"]:hover {
            background-color: #7f8c8d;
        }
    </style>
{% endblock %}

{% block body %}
<section class="section__container">
    <h2 class="section__header">Ajouter une activité</h2>

    {% for flash in app.flashes('success') %}
        <div class="alert alert-success">
            {{ flash }}
        </div>
    {% endfor %}

    {{ form_start(form, {'attr': {'data-turbo': 'false'}}) }}
        <div class="input__group">
            {{ form_label(form.name, 'Nom de l\'activité') }}
            {{ form_widget(form.name, {'attr': {'placeholder': 'Ex: Randonnée en montagne'}}) }}
            {{ form_errors(form.name) }}
        </div>

        <div class="input__group">
            {{ form_label(form.description, 'Description') }}
            {{ form_widget(form.description, {'attr': {'placeholder': 'Décrivez l\'activité en détail...', 'rows': 4}}) }}
            {{ form_errors(form.description) }}
        </div>

        <div class="input__group">
            {{ form_label(form.price, 'Prix (€)') }}
            {{ form_widget(form.price, {'attr': {'placeholder': 'Ex: 45.00', 'step': '0.01'}}) }}
            {{ form_errors(form.price) }}
        </div>

        <div class="input__group">
            {{ form_label(form.duration, 'Durée') }}
            {{ form_widget(form.duration, {'attr': {'placeholder': 'Ex: 3 heures'}}) }}
            {{ form_errors(form.duration) }}
        </div>

        <button type="submit" class="btn">Ajouter l'activité</button>
        <button type="reset" class="btn">Effacer</button>
    {{ form_end(form) }}
</section>
{% endblock %}
